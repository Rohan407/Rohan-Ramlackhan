# API Keys (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
ELEVENLABS_API_KEY=your-elevenlabs-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
LANGSMITH_API_KEY=your-langsmith-api-key
GOOGLE_CREDENTIALS_PATH=/app/credentials/google-credentials.json

# Social Media Credentials (Optional)
FACEBOOK_EMAIL=your-facebook-email@example.com
FACEBOOK_PASSWORD=your-facebook-password

# Business Settings
COMPANY_NAME=Premium Roofing Solutions
BUSINESS_PHONE=+1234567890
SERVICE_AREA_RADIUS=50

# Outreach Limits
MAX_DAILY_SMS=200
MAX_DAILY_CALLS=100
CALL_HOURS_START=9
CALL_HOURS_END=18

# System Settings
DEBUG=false
LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379